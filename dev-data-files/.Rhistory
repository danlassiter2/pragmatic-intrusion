d$diff = d$positive - d$negative
d$abs.diff = abs(d$diff)
d$between = !is.na(d$consequent) & (d$positive <= d$consequent & d$consequent <= d$negative) | (d$negative < d$consequent & d$consequent < d$positive)
d$aboveBoth = !is.na(d$consequent) & (d$positive < d$consequent & d$negative < d$consequent)
d$belowBoth = !is.na(d$consequent) & (d$positive > d$consequent & d$negative > d$consequent)
d$stim.type = sapply(1:length(d[,1]), FUN=function(i) {
if (d[i,]$itemNumber > 10) {
return('walrus')
} else {
if (d[i,]$showContext == TRUE) {
return('independence')
} else {
return('dependence')
}
}
})
# compute proportion of judgments where consequent is between pos and neg, by condition
p = filter(d, condition != 'infStrength') %>%
group_by(condition, stim.type, between) %>%
summarize(n())
props.between = p[c(2,4,6,8,10,12),]
props.between$total = props.between$`n()` + p[c(1,3,5,7,9,11),]$`n()`
props.between$proportion = props.between$`n()`/props.between$total
props.between$viol = 1-props.between$proportion
# compute proportion of judgments where P(C) is below both P(if A,C) and P(if A, not C)
# should be low bc we expect *conditionals* to have depressed, not increased prob, but for Walrus only
p2 = filter(d, condition != 'infStrength') %>%
group_by(condition, stim.type, belowBoth) %>%
summarize(n())
props.below = p2[c(2,4,6,8,10,12),]
props.below$proportion = props.below$`n()`/(props.below$`n()` + p2[c(1,3,5,7,9,11),]$`n()`)
# compute proportion of judgments where P(C) is above both P(if A,C) and P(if A, not C)
# should be higher for Walrus conditionals than others, on our hypothesis
# inferentialism predicts should be same for Walrus and independence
p3 = filter(d, condition != 'infStrength') %>%
group_by(condition, stim.type, aboveBoth) %>%
summarize(n())
props.above = p3[c(2,4,6,8,10,12),]
props.above$proportion = props.above$`n()`/(props.above$`n()` + p3[c(1,3,5,7,9,11),]$`n()`)
####
#
# compute trial means as a step toward subject means
# for z-scoring
d$trial.mean = sapply(1:length(d[,1]), FUN=function(i) {
if (is.na(d[i,]$consequent)) {
return(mean(c(d[i,]$positive, d[i,]$negative)))
} else {
return(mean(c(d[i,]$positive, d[i,]$negative, d[i,]$consequent)))
}
})
d$subj.mean = sapply(1:length(d[,1]), FUN=function(i) {
return(mean(filter(d, ID == d[i,]$ID)$trial.mean))
})
d$subj.sd = sapply(1:length(d[,1]), FUN=function(i) {
return(sd(filter(d, ID == d[i,]$ID)$trial.mean))
})
d$subj.mean.diff = sapply(1:length(d[,1]), FUN=function(i) {
return(mean(filter(d, ID == d[i,]$ID)$diff))
})
d$subj.sd.diff = sapply(1:length(d[,1]), FUN=function(i) {
return(sd(filter(d, ID == d[i,]$ID)$diff))
})
# compute z-scores for all responses
d$z.consequent = (d$consequent - d$subj.mean)/d$subj.sd
d$z.positive = (d$positive - d$subj.mean)/d$subj.sd
d$z.negative = (d$negative - d$subj.mean)/d$subj.sd
d$z.diff = (d$diff - d$subj.mean.diff)/d$subj.sd.diff
d$abs.z.diff = abs(d$z.diff)
d$condition <- factor(d$condition, levels = c("infStrength", "probability", "suppose"), labels = c("infStrength", "Probability", "Suppose")
)
d$stim.type <- factor(d$stim.type, levels = c("dependence", "independence", "walrus"), labels = c("Dependence", "Independence", "Walrus")
)
# What was the mean difference between positive and negative, by condition?
# raw diffs
group_by(d, condition) %>%
ggplot(mapping=aes(x=stim.type, y=abs(diff))) +
geom_boxplot() +
facet_wrap(~ condition) +
xlab('Item type') +
ylab('Mean absolute difference')
# look at abs diff by item
group_by(d, itemNumber) %>%
ggplot(mapping=aes(x=stim.type, y=abs.diff)) +
geom_boxplot() +
facet_wrap(~ itemNumber) +
ylab('Mean absolute difference')
